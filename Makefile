NAME = libft.a
CC = cc
CFLAGS = -Wall -Wextra -Werror
AR = ar rcs
RM = rm -f
OBJDIR = objs
LIBDIR = lib

# Source files - List of all C files to compile (generated by script)
SRC_FILES = \
	src/convert/ft_atoi.c \
	src/convert/ft_atol.c \
	src/convert/ft_itoa.c \
	src/convert/ft_tolower.c \
	src/convert/ft_toupper.c \
	src/ctype/ft_isalnum.c \
	src/ctype/ft_isalpha.c \
	src/ctype/ft_isascii.c \
	src/ctype/ft_isdigit.c \
	src/ctype/ft_isprint.c \
	src/ctype/ft_isquote.c \
	src/ctype/ft_issing.c \
	src/ctype/ft_isspace.c \
	src/gnl/get_next_line.c \
	src/list/ft_lstadd_back.c \
	src/list/ft_lstadd_front.c \
	src/list/ft_lstclear.c \
	src/list/ft_lstdelone.c \
	src/list/ft_lstiter.c \
	src/list/ft_lstlast.c \
	src/list/ft_lstmap.c \
	src/list/ft_lstnew.c \
	src/list/ft_lstsize.c \
	src/memory_freeing/ft_free_array2.c \
	src/memory_freeing/ft_free_array.c \
	src/memory_freeing/ft_free_array_n.c \
	src/memory/ft_bzero.c \
	src/memory/ft_calloc.c \
	src/memory/ft_memchr.c \
	src/memory/ft_memcmp.c \
	src/memory/ft_memmove.c \
	src/memory/ft_memset.c \
	src/output/ft_putchar_fd.c \
	src/output/ft_putendl_fd.c \
	src/output/ft_putnbr_fd.c \
	src/output/ft_putstr_fd.c \
	src/string/ft_split.c \
	src/string/ft_strchr.c \
	src/string/ft_strcmp.c \
	src/string/ft_strdup.c \
	src/string/ft_striteri.c \
	src/string/ft_strjoin.c \
	src/string/ft_strjoin_three.c \
	src/string/ft_strlcat.c \
	src/string/ft_strlcpy.c \
	src/string/ft_strlen.c \
	src/string/ft_strmapi.c \
	src/string/ft_strncmp.c \
	src/string/ft_strnstr.c \
	src/string/ft_strrchr.c \
	src/string/ft_strtrim.c \
	src/string/ft_substr.c

SRC = $(SRC_FILES)

# Objects - Convert source files (.c) to object files (.o) in the objects directory
OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(SRC_FILES))

# Headers location - Where to find the header files (.h)
INCLUDES = ./include/

# Rules - How to build the library
# Format: target: dependencies
#   commands to build target
#
# 'all' - Default target that builds the complete library
# $(NAME) - The output file (libft.a)
all: $(OBJDIR)/src $(LIBDIR) $(LIBDIR)/$(NAME)

# Create the objects directory if it doesn't exist
$(OBJDIR):
	mkdir -p $(OBJDIR)/src

# Create the library directory if it doesn't exist
$(LIBDIR):
	mkdir -p $(LIBDIR)

# Each .o has as dependency a same name .c
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(INCLUDES) -c $< -o $@

# Target program (libft.a) has as dependencies the OBJS
$(LIBDIR)/$(NAME): $(OBJS)
	$(AR) $@ $(OBJS)

# clean doesn't have dependencies, it just executes command
clean:
	$(RM) -r $(OBJDIR)

# fclean executes first clean as it has it as dependency
fclean: clean
	$(RM) $(LIBDIR)/$(NAME)
	$(RM) -r $(LIBDIR)

# re executes fclean and then re-make all
re: fclean all

.PHONY: all clean fclean re $(OBJDIR)/src $(LIBDIR)
